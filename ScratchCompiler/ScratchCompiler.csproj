<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Codegen\Codegen.csproj" />
      <ProjectReference Include="..\Parser\Parser.csproj" />
    </ItemGroup>

    <Target Name="CopyNativeLibrary" AfterTargets="PostBuildEvent">
        <MSBuild Projects="..\libScratch\libScratch.vcxproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);Platform=x64" />
        
        <Copy SourceFiles="$(SolutionDir)Libs\libScratch.lib"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true">
            <!-- Capture exactly which files were copied -->
            <Output TaskParameter="CopiedFiles" ItemName="ActualCopiedFiles" />
        </Copy>
        <Message Text="$(SolutionDir)Libs\libScratch.lib -> @(ActualCopiedFiles)" Importance="high" />
    </Target>

    <Target Name="CopySysrootToOutput" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <SysrootSource>$(llvm-sysroot)</SysrootSource>
            <SysrootDestination>$(TargetDir)libs</SysrootDestination>
        </PropertyGroup>

        <ItemGroup Condition="Exists('$(SysrootSource)')">
            <SysrootFiles Include="$(SysrootSource)\**\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(SysrootFiles)"
              DestinationFolder="$(SysrootDestination)\%(RecursiveDir)"
              SkipUnchangedFiles="true">
            <Output TaskParameter="CopiedFiles" ItemName="CopiedSysrootFiles" />
        </Copy>

        <Warning Text="Zmienna 'llvm-sysroot' nie jest ustawiona! Kopiowanie pominięte."
                 Condition="!Exists('$(SysrootSource)')" />
    </Target>
</Project>
